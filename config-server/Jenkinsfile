pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and test') {
            when {
                branch 'feature/config-server'
            }
            environment {
                TESTCONTAINERS_HOST_OVERRIDE = 'host.docker.internal'
            }
            steps {
                sh 'mvn -B -ntp -Dmaven.repo.local="$WORKSPACE/.m2/repository" -DskipTests=false -Dmaven.test.skip=false -f config-server/pom.xml clean verify'
            }
        }

        stage('SonarQube analysis') {
            when {
                branch 'feature/config-server'
            }
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn -B -ntp -Dmaven.repo.local="$WORKSPACE/.m2/repository" -f config-server/pom.xml org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar -Dsonar.host.url=http://sonarqube:9000 -Dsonar.projectKey=gl5-g4-config-server -Dsonar.projectName="Config Server"'
                }
            }
        }

        stage('Quality gate') {
            when {
                branch 'feature/config-server'
            }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        always {
            echo "Mail Sent"
        }
    }
}
