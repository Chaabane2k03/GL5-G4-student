def sonarQualityGateStatus = 'NOT_RUN'
def sonarDashboardUrl = 'NOT_AVAILABLE'
def buildAndTestStatus = 'NOT_RUN'

pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and test') {
            when {
                branch 'feature/config-server'
            }
            environment {
                TESTCONTAINERS_HOST_OVERRIDE = 'host.docker.internal'
            }
            steps {
                sh 'mvn -B -ntp -Dmaven.repo.local="$WORKSPACE/.m2/repository" -DskipTests=false -Dmaven.test.skip=false -f config-server/pom.xml clean verify'
            }
            post {
                success {
                    script {
                        buildAndTestStatus = 'SUCCESS'
                    }
                }
                unsuccessful {
                    script {
                        buildAndTestStatus = currentBuild.currentResult
                    }
                }
            }
        }

        stage('SonarQube analysis') {
            when {
                branch 'feature/config-server'
            }
            steps {
                withSonarQubeEnv('SonarQube') {
                    script {
                        sonarDashboardUrl = "${env.SONAR_HOST_URL}/dashboard?id=gl5-g4-config-server"
                    }
                    sh 'mvn -B -ntp -Dmaven.repo.local="$WORKSPACE/.m2/repository" -f config-server/pom.xml org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar -Dsonar.projectKey=gl5-g4-config-server -Dsonar.projectName="Config Server"'
                }
            }
        }

        stage('Quality gate') {
            when {
                branch 'feature/config-server'
            }
            steps {
                script {
                    timeout(time: 5, unit: 'MINUTES') {
                        def qualityGate = waitForQualityGate(abortPipeline: false)
                        sonarQualityGateStatus = qualityGate.status
                        if (qualityGate.status != 'OK') {
                            error "SonarQube quality gate failed: ${qualityGate.status}"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            junit testResults: 'config-server/target/surefire-reports/TEST-*.xml', allowEmptyResults: true
            emailext(
                to: env.EMAIL_RECIPIENTS,
                subject: "[${currentBuild.currentResult}] ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                mimeType: 'text/html',
                body: """
                    <h2>Config Server build ${currentBuild.currentResult}</h2>
                    <p>The Jenkins build has completed. Review the attached console log for the full build output.</p>
                    <ul>
                        <li><strong>Job:</strong> ${env.JOB_NAME}</li>
                        <li><strong>Build:</strong> <a href="${env.BUILD_URL}">#${env.BUILD_NUMBER}</a></li>
                        <li><strong>Branch:</strong> ${env.BRANCH_NAME ?: 'unknown'}</li>
                        <li><strong>Commit:</strong> ${env.GIT_COMMIT ?: 'unknown'}</li>
                        <li><strong>Build and tests:</strong> ${buildAndTestStatus}</li>
                        <li><strong>Overall Jenkins result:</strong> ${currentBuild.currentResult}</li>
                        <li><strong>SonarQube Quality Gate:</strong> ${sonarQualityGateStatus}</li>
                        <li><strong>SonarQube project:</strong> <a href="${sonarDashboardUrl}">${sonarDashboardUrl}</a></li>
                    </ul>
                    <p>Attachments include the Jenkins console log and available Maven test, coverage, and SonarQube task reports.</p>
                """,
                attachLog: true,
                attachmentsPattern: 'config-server/target/surefire-reports/*.txt,config-server/target/site/jacoco/jacoco.xml,config-server/target/sonar/report-task.txt,config-server/.scannerwork/report-task.txt'
            )
        }
    }
}
