# Copy to .env and fill in values. Never commit .env or real credentials.
CONFIG_REPO_URI=https://github.com/your-org/config-repo
GIT_USER=
GIT_TOKEN=
CONFIG_USER=config
CONFIG_PASSWORD=replace-with-a-strong-password
ENCRYPT_KEY=replace-with-a-generated-secret-key

# ---- Jenkins controller (docker-compose.jenkins.yml) ----
# Jenkins UI: http://localhost:${JENKINS_PORT} - login with JENKINS_ADMIN_USER/PASSWORD.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin
JENKINS_PORT=8091
JENKINS_EXTERNAL_URL=http://localhost:8091/

# Shared SonarQube (repository root: docker compose -f docker-compose.sonar.yml up -d).
# 1) Open http://localhost:9000 and change the admin password if forced.
# 2) My Account > Security > Generate Token (the same token works for every service).
# 3) Put the token below.
# 4) Register this controller's SonarQube webhook (needed by waitForQualityGate):
#    docker compose -f docker-compose.jenkins.yml run --rm sonar-webhook-init
SONAR_TOKEN=
