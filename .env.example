# Optional overrides for the root Compose stack.
# Copy this file to .env only when you need to change ports, browser-facing URLs,
# or the local Keycloak bootstrap administrator. Never commit the real .env file.

# Browser-facing URLs injected into the frontend /config.json at startup.
API_BASE_URL=http://localhost:8072
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=gl5
KEYCLOAK_CLIENT_ID=cursus-frontend

# Host ports.
FRONTEND_PORT=4200
KEYCLOAK_PORT=8081

# Local development bootstrap administrator (master realm).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
