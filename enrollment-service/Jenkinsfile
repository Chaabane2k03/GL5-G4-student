pipeline {
    agent any

    options {
        timestamps()
    }

    // NEW: opt-in switch so normal builds never touch AWS
    parameters {
        booleanParam(name: 'PUSH_TO_ECR', defaultValue: false,
                     description: 'Push image to ECR (needs lab running + ECR repos created)')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                dir('enrollment-service') {
                    sh 'mvn -B clean verify'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'enrollment-service/target/surefire-reports/TEST-*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir('enrollment-service') {
                        sh '''
                            mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                              -Dsonar.projectKey=enrollment-service \
                              -Dsonar.projectName="Enrollment Service"
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('enrollment-service') {
                    sh 'docker build -t enrollment-service:${BUILD_NUMBER} -t enrollment-service:latest .'
                }
            }
        }

        // NEW: validates the team's Terraform without touching AWS
        stage('Terraform Validate') {
            when { expression { fileExists('deploy/terraform') } }
            steps {
                dir('deploy/terraform') {
                    sh '''
                        terraform fmt -check -recursive
                        terraform init -backend=false -input=false
                        terraform validate
                    '''
                }
            }
        }

        // NEW: only runs when you tick PUSH_TO_ECR
        stage('Push to ECR') {
            when { expression { params.PUSH_TO_ECR } }
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key-id',     variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY'),
                    string(credentialsId: 'aws-session-token',     variable: 'AWS_SESSION_TOKEN')
                ]) {
                    sh '''
                        export AWS_DEFAULT_REGION=us-east-1
                        ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
                        REGISTRY=$ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com
                        REPO=$REGISTRY/gl5-g4-enrollment-service

                        aws ecr get-login-password | docker login --username AWS --password-stdin $REGISTRY

                        docker tag enrollment-service:$BUILD_NUMBER $REPO:$BUILD_NUMBER
                        docker tag enrollment-service:$BUILD_NUMBER $REPO:latest
                        docker push $REPO:$BUILD_NUMBER
                        docker push $REPO:latest
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline succeeded'
        }
        failure {
            echo 'Pipeline failed'
        }
        always {
            emailext(
                to: 'jdidiabderrahmen1@gmail.com',
                subject: "${env.JOB_NAME} - Build #${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
                mimeType: 'text/html',
                body: """
                    <h2>Jenkins Build Report</h2>
                    <p><b>Project:</b> ${env.JOB_NAME}</p>
                    <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>
                    <p><b>Status:</b> ${currentBuild.currentResult}</p>
                    <p><b>Build URL:</b>
                    <a href="${env.BUILD_URL}">Open build details</a></p>
                    <p><b>Console Output:</b>
                    <a href="${env.BUILD_URL}console">View console output</a></p>
                """
            )
        }
    }
}