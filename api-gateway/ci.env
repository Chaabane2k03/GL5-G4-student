# ==============================================================================
# CI/CD Environment Configuration - API Gateway
# ==============================================================================

# Branch & Versioning
RELEASE_BRANCH=main
VERSION_PREFIX=1.0

# Docker Packaging
ENABLE_DOCKER_BUILD=true

# Nexus Configuration
NEXUS_CREDS_ID=nexus
NEXUS_BASE_URL=http://nexus-igl5:8081
NEXUS_RELEASE_REPO_NAME=gl5-student-releases
NEXUS_SNAPSHOT_REPO_NAME=gl5-student-snapshots
NEXUS_RELEASE_REPO_ID=gl5-student-releases
NEXUS_SNAPSHOT_REPO_ID=gl5-student-snapshots

# SonarQube Configuration
SONAR_ENV_NAME=SonarQube
SONAR_PROJECT_KEY=api-gateway
SONAR_PROJECT_NAME="API Gateway"


# Email Notifications
NOTIFICATION_EMAIL=chaabaneboussadia@gmail.com
