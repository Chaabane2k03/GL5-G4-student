def sonarQualityGateStatus = 'NOT_RUN'
def sonarDashboardUrl = 'NOT_AVAILABLE'
def buildAndTestStatus = 'NOT_RUN'

pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }

    environment {
        DOCKER_IMAGE = 'gl5-g4-department-service'
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check environment') {
            steps {
                sh '''
                    set -eu
                    command -v docker || {
                        echo >&2 'Docker CLI is missing on the Jenkins built-in node.'
                        echo >&2 'Rebuild Jenkins with jenkins/Dockerfile and mount /var/run/docker.sock.'
                        exit 1
                    }
                    command -v curl || {
                        echo >&2 'curl is required on the Jenkins built-in node.'
                        exit 1
                    }
                    docker info >/dev/null || {
                        echo >&2 'Jenkins cannot access the Docker daemon. Check the Docker socket mount and group_add configuration.'
                        exit 1
                    }
                    docker compose version >/dev/null || {
                        echo >&2 'Docker Compose v2 is missing from the Jenkins image.'
                        exit 1
                    }
                    curl --fail --silent --show-error \
                        --retry 5 --retry-connrefused --retry-delay 2 \
                        --output /dev/null \
                        https://repo.maven.apache.org/maven2/org/springframework/boot/spring-boot-starter-parent/3.5.5/spring-boot-starter-parent-3.5.5.pom || {
                        echo >&2 'Maven Central is unreachable from the Jenkins built-in node. Check Jenkins Docker DNS/network settings.'
                        exit 1
                    }
                    java -version
                    mvn -version
                '''
            }
        }

        stage('Build and test with H2') {
            steps {
                sh '''
                    set -eu
                    echo "Building from Jenkins workspace: $WORKSPACE"
                    test -f department-service/pom.xml || {
                        echo >&2 'department-service/pom.xml is missing from the checked-out Jenkins workspace.'
                        exit 1
                    }
                    mkdir -p "$WORKSPACE/.m2/repository"

                    attempt=1
                    while [ "$attempt" -le 3 ]; do
                        log_file=$(mktemp "$WORKSPACE/.maven-verify.XXXXXX")
                        set +e
                        mvn -U -B -ntp \
                            -Dmaven.repo.local="$WORKSPACE/.m2/repository" \
                            -f department-service/pom.xml clean verify >"$log_file" 2>&1
                        status=$?
                        set -e
                        cat "$log_file"

                        if [ "$status" -eq 0 ]; then
                            rm -f "$log_file"
                            exit 0
                        fi
                        if ! grep -Eqi 'UnknownHostException|Unknown host|Temporary failure in name resolution|Name or service not known' "$log_file" \
                            || [ "$attempt" -eq 3 ]; then
                            exit "$status"
                        fi

                        echo "Maven Central DNS failed; retrying verification (attempt $((attempt + 1)) of 3)."
                        rm -f "$log_file"
                        attempt=$((attempt + 1))
                        sleep 5
                    done
                '''
            }
            post {
                success {
                    script {
                        buildAndTestStatus = 'SUCCESS'
                    }
                }
                unsuccessful {
                    script {
                        buildAndTestStatus = currentBuild.currentResult
                    }
                }
            }
        }

        stage('Build and run with MySQL') {
            steps {
                sh '''
                    set -eu
                    docker compose -p "department-service-$BUILD_NUMBER" \
                        -f department-service/compose.yaml up -d --build
                    ready=0
                    for attempt in $(seq 1 60); do
                        if curl --fail --silent --show-error --connect-timeout 2 \
                            http://host.docker.internal:8082/v3/api-docs >/dev/null; then
                            ready=1
                            break
                        fi
                        sleep 2
                    done
                    if [ "$ready" -ne 1 ]; then
                        echo >&2 'Department service did not respond through the Docker host gateway at host.docker.internal:8082.'
                        docker compose -p "department-service-$BUILD_NUMBER" \
                            -f department-service/compose.yaml ps
                        docker compose -p "department-service-$BUILD_NUMBER" \
                            -f department-service/compose.yaml logs
                        exit 1
                    fi
                    docker image inspect "$DOCKER_IMAGE:$BUILD_NUMBER" >/dev/null
                '''
            }
            post {
                always {
                    sh '''
                        docker compose -p "department-service-$BUILD_NUMBER" \
                            -f department-service/compose.yaml down --volumes --remove-orphans
                    '''
                }
            }
        }

        stage('SonarQube analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    script {
                        sonarDashboardUrl = "${env.SONAR_HOST_URL}/dashboard?id=gl5-g4-department-service"
                    }
                    sh '''
                        set -eu
                        mvn -U -B -ntp \
                            -Dmaven.repo.local="$WORKSPACE/.m2/repository" \
                            -f department-service/pom.xml \
                            org.sonarsource.scanner.maven:sonar-maven-plugin:5.3.0.6276:sonar \
                            -Dsonar.projectKey=gl5-g4-department-service \
                            -Dsonar.projectName="Department Service"
                    '''
                }
            }
        }

        stage('Quality gate') {
            steps {
                script {
                    timeout(time: 5, unit: 'MINUTES') {
                        def qualityGate = waitForQualityGate(abortPipeline: false)
                        sonarQualityGateStatus = qualityGate.status
                        if (qualityGate.status != 'OK') {
                            error "SonarQube quality gate failed: ${qualityGate.status}"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def testReport = sh(
                    script: 'if [ -d department-service/target/surefire-reports ]; then find department-service/target/surefire-reports -maxdepth 1 -type f -name "TEST-*.xml" -print -quit; fi',
                    returnStdout: true
                ).trim()
                if (testReport) {
                    junit testResults: 'department-service/target/surefire-reports/TEST-*.xml',
                        allowEmptyResults: true
                } else {
                    echo 'No Maven test reports were produced.'
                }
            }
            archiveArtifacts artifacts: 'department-service/target/department-service.jar,department-service/target/site/jacoco/jacoco.xml',
                allowEmptyArchive: true
            script {
                if (env.EMAIL_RECIPIENTS?.trim()) {
                    emailext(
                        to: env.EMAIL_RECIPIENTS,
                        subject: "[${currentBuild.currentResult}] ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                        mimeType: 'text/html',
                        body: """
                            <h2>Department Service build ${currentBuild.currentResult}</h2>
                            <ul>
                                <li><strong>Job:</strong> ${env.JOB_NAME}</li>
                                <li><strong>Build:</strong> <a href="${env.BUILD_URL}">#${env.BUILD_NUMBER}</a></li>
                                <li><strong>Branch:</strong> ${env.GIT_BRANCH ?: 'unknown'}</li>
                                <li><strong>Commit:</strong> ${env.GIT_COMMIT ?: 'unknown'}</li>
                                <li><strong>Build and tests:</strong> ${buildAndTestStatus}</li>
                                <li><strong>Overall Jenkins result:</strong> ${currentBuild.currentResult}</li>
                                <li><strong>SonarQube Quality Gate:</strong> ${sonarQualityGateStatus}</li>
                                <li><strong>SonarQube project:</strong> <a href="${sonarDashboardUrl}">${sonarDashboardUrl}</a></li>
                                <li><strong>Docker image:</strong> ${env.DOCKER_IMAGE}:${env.BUILD_NUMBER}</li>
                            </ul>
                        """,
                        attachLog: true,
                        attachmentsPattern: 'department-service/target/surefire-reports/*.txt,department-service/target/site/jacoco/jacoco.xml,department-service/target/sonar/report-task.txt,department-service/.scannerwork/report-task.txt'
                    )
                } else {
                    echo 'EMAIL_RECIPIENTS is not configured; skipping build notification.'
                }
            }
        }
    }
}
