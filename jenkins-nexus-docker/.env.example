# --- AWS / Terraform deployment (Jenkinsfile stage "Deploy to AWS") ---
# Fill these in jenkins-nexus-docker/.env (git-ignored), NEVER in this example
# file. Learner Lab credentials are temporary: refresh them every session, then
# recreate Jenkins (docker compose ... up -d --force-recreate jenkins).
# AWS_SESSION_TOKEN is required for Learner Lab and empty for long-lived keys.
# The region is not set here: it is the AWS_REGION build parameter (default us-east-1).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=