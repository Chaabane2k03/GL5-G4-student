# ---------------------------------------------------------------------------
# Copy to .env and adjust as needed. .env is git-ignored; only this example is committed.
# Every value below has a sensible default baked into application.yml / docker-compose.yml,
# so this file documents the knobs and lets you override them per environment.
# ---------------------------------------------------------------------------

# ---- Database (app connection) ----
DB_HOST=localhost
DB_PORT=3308
DB_NAME=course_db
DB_USER=course_user
DB_PASSWORD=course_pass
MYSQL_ROOT_PASSWORD=rootpass
# Extra JDBC URL parameters appended after the '?' of the datasource URL.
DB_JDBC_PARAMS=useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ---- MySQL container (docker compose) ----
MYSQL_IMAGE=mysql:8.0
DB_CONTAINER_NAME=course-db
DB_SERVICE_NAME=course-db
DB_CONTAINER_PORT=3306
DB_HOST_PORT=3308

# ---- Application ----
SERVER_PORT=8084
SPRING_APP_NAME=course-service
JPA_DDL_AUTO=validate
JPA_OPEN_IN_VIEW=false
HIBERNATE_JDBC_TIME_ZONE=UTC
SQL_INIT_MODE=always
SQL_SCHEMA_LOCATIONS=classpath:schema.sql
LOG_LEVEL_ROOT=INFO
MANAGEMENT_ENDPOINTS=health,info
MANAGEMENT_HEALTH_PROBES=true

# ---- OpenAPI / Swagger ----
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
SPRINGDOC_API_DOCS_PATH=/v3/api-docs
APP_OPENAPI_TITLE=Course Service API
APP_OPENAPI_VERSION=v1
APP_OPENAPI_DESCRIPTION=REST API to manage courses: create, read, update, archive and activate. Standalone service; departments are referenced by id only.

# ---- Service container (docker compose) ----
SERVICE_IMAGE=course-service:latest
SERVICE_CONTAINER_NAME=course-service

# ---- SonarQube stack (docker compose -f docker-compose.sonar.yml) ----
SONAR_PORT=9000
SONAR_IMAGE=sonarqube:10.6-community
SONAR_CONTAINER_NAME=course-sonarqube
SONAR_DB_IMAGE=postgres:15-alpine
SONAR_DB_CONTAINER_NAME=course-sonar-db
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar
SONAR_DB_NAME=sonar
SONAR_JDBC_URL=jdbc:postgresql://sonar-db:5432/sonar
SONAR_ES_BOOTSTRAP_CHECKS_DISABLE=true
